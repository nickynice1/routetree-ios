<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Das Privacy Manifest. Pflicht seit Frühjahr 2024 für jede App, die
	  eine „Required Reason API" benutzt — und ohne es wird der Upload
	  nach App Store Connect zurückgewiesen.

	  Hier steht bewusst wenig, weil die App wenig tut. Jeder Eintrag
	  hat einen Grund, und was nicht gebraucht wird, steht nicht drin:
	  Ein Manifest, das vorsorglich alles anmeldet, ist eine Auskunft
	  über Daten, die man gar nicht erhebt.
	-->

	<!-- Kein Tracking. Kein Werbenetzwerk, kein Analysedienst, keine
	     Verknüpfung mit Daten Dritter. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Der Benutzername. Er wird für die Anmeldung gebraucht
			     und ist mit der Person verknüpft — das ist der Sinn
			     eines Kontos, also wird es auch so angegeben. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  Der Schlüsselbund fällt unter „User Defaults" im Sinne
			  dieser Liste: Die App legt dort das Tokenpaar ab, damit
			  man sich nicht bei jedem Start neu anmelden muss.
			  Grund CA92.1 = ausschließlich für die eigene App.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
